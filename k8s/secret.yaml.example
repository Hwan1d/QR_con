apiVersion: v1
kind: Secret
metadata:
  name: qr-canvas-secret
  namespace: default
type: Opaque
stringData:
  # 실제 환경 변수 값으로 입력하여 kubectl apply -f secret.yaml 로 적용하세요.
  SUPABASE_URL: "https://your-supabase-url.supabase.co"
  SUPABASE_KEY: "your-supabase-anon-key"
  GEMINI_API_KEY: "your-gemini-api-key"
